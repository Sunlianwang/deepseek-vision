# ============================================================
# deepseek-vision · 环境变量模板
# 复制为 .env 并填入你自己的 opencode zen API key
# 获取方式: https://opencode.ai/auth → 登录 → 复制 API Key
# ============================================================

# ---- 必填 ----
# 你的 opencode zen API key（sk- 开头）
OPENCODE_API_KEY=sk-在这里填入你自己的opencode-zen-key

# ---- 可选（以下均有默认值，一般无需修改）----

# opencode zen API 基础地址（DeepSeek / MiMo 走 OpenAI 兼容的 chat/completions）
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# 【分端点配置】感知层与推理层想用不同厂商的 API 时，单独指定端点（可选）
# 示例：推理层用 DeepSeek 官方、感知层继续用 zen 免费 mimo：
#   TEXT_BASE_URL=https://api.deepseek.com
#   TEXT_MODEL=deepseek-chat
#   MULTIMODAL_BASE_URL=https://opencode.ai/zen/v1
# 留空则感知/推理都走 OPENCODE_BASE_URL
# MULTIMODAL_BASE_URL=
# TEXT_BASE_URL=

# 感知层：多模态模型（图像/音频/视频识别），默认使用免费的 MiMo-V2.5
MULTIMODAL_MODEL=mimo-v2.5-free

# 推理层：后端大脑，默认 DeepSeek V4 Flash Free（免费，无需绑定支付方式）
# 若你的 zen 账号已绑定支付方式，可改用更强/更稳的付费版: deepseek-v4-flash
TEXT_MODEL=deepseek-v4-flash-free

# 音频 / 视频专用模型（默认跟随 MULTIMODAL_MODEL，通常无需设置）
# AUDIO_MODEL=
# VIDEO_MODEL=

# 单文件大小上限（MB），超过会被拒绝
MAX_MEDIA_MB=20

# 视频抽帧数量（需要本机安装 ffmpeg）
VIDEO_FRAMES=4

# 请求超时（毫秒）
REQUEST_TIMEOUT_MS=180000

# 生成参数
TEMPERATURE=0.3
MAX_TOKENS=4096
